# Optional but recommended. Powers the desktop "Share to X" flow: the
# generated badge is uploaded to Cloudinary (free tier) so the tweet link
# unfurls with the real image instead of a blank preview.
#
# Without these set, the app still works end-to-end: on mobile it uses the
# native share sheet (attaches the image directly, no Cloudinary needed);
# on desktop it falls back to "download + open a text-only tweet".
#
# Setup (~2 minutes): see README.md "Cloudinary setup".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
